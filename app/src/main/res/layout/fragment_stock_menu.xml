<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="工程60 中間在庫置場メニュー"
        style="@style/Widget.BTTokyu.TitleBar"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:gravity="center" android:padding="24dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="処理を選択してください"
            android:gravity="center" android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStockOut"
            style="@style/Widget.BTTokyu.MenuButton"
            android:text="出庫"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStockReturn"
            style="@style/Widget.BTTokyu.MenuButton"
            android:text="返却"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent" android:layout_height="52dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="戻る"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</LinearLayout>
