<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="工程74 廃棄処理" style="@style/Widget.BTTokyu.TitleBar"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="廃棄するHTをスキャンしてください（1品番ずつ）"
                android:textSize="14sp" android:layout_marginBottom="16dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView style="@style/Widget.BTTokyu.FieldLabel" android:text="部品名"/>
                <TextView android:id="@+id/tvBname" style="@style/Widget.BTTokyu.FieldValue"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView style="@style/Widget.BTTokyu.FieldLabel" android:text="品番"/>
                <TextView android:id="@+id/tvHinban" style="@style/Widget.BTTokyu.FieldValue"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView style="@style/Widget.BTTokyu.FieldLabel" android:text="枝番"/>
                <TextView android:id="@+id/tvEban" style="@style/Widget.BTTokyu.FieldValue"
                    android:layout_weight="1"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ボタン行 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:weightSum="2">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiscard" style="@style/Widget.BTTokyu.ActionButton"
            android:layout_weight="1" android:text="廃棄処理"
            android:backgroundTint="@color/danger"
            android:enabled="false" android:layout_marginEnd="6dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack" style="@style/Widget.BTTokyu.BackButton"
            android:layout_weight="1" android:text="戻る"/>
    </LinearLayout>
</LinearLayout>
